<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.jarvis.mcp-server</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd /Users/jarvis/.openclaw/workspace-yoda/claude-mcp-server &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; /usr/bin/env node server.js</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/jarvis/.openclaw/workspace-yoda/claude-mcp-server</string>

    <key>StandardOutPath</key>
    <string>/Users/jarvis/.openclaw/logs/mcp-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jarvis/.openclaw/logs/mcp-server.log</string>
  </dict>
</plist>
