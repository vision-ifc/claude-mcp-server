# MCP server bind
MCP_HOST=127.0.0.1
MCP_PORT=8787

# Required auth for Claude -> MCP requests
MCP_API_KEY=replace-with-a-random-secret

# Existing OpenClaw gateway on the Mac Mini
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=replace-with-openclaw-gateway-token
DEFAULT_AGENT_ID=artoo

# Optional integrations
LINEAR_API_KEY=replace-with-linear-api-key
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=
